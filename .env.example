# Model provider (triage agent)
OPENAI_API_KEY=

# GitHub App — READ-ONLY permissions: Pull requests, Contents, Metadata.
# The app must have NO write permissions; the read-only guardrail is enforced
# at the infrastructure layer, not by prompting.
GITHUB_APP_ID=
# PEM private key. Multi-line: escape newlines as \n or use a base64-encoded value.
GITHUB_PRIVATE_KEY=
# Webhook secret set on the GitHub App — signature verification is never skipped.
GITHUB_WEBHOOK_SECRET=
# Installation ID for the repo the app is installed on (e.g. CreatorSignal)
GITHUB_INSTALLATION_ID=
# REQUIRED for Station 2: a fine-grained PAT with Contents:read on weft.
# It builds the sandbox base image, whose recipe bakes a clone of weft plus
# its gem bundle. Railway caches template builds by content, so this value
# must be STABLE — a rotating App installation token forces a ~60s rebuild
# every time. Railway ${{shared.*}} references do NOT resolve inside
# sandboxes (verified), so the value has to be inline here.
# Per-triage git operations do NOT use this: they use short-lived App
# installation tokens delivered to sandbox tmpfs. Without this the factory
# has no workspace and triages read-only.
GITHUB_TOKEN=

# Slack (demo workspace) — see docs/guides/slack-setup.md
# All three vars below are required together: cards post and thread Q&A is
# answered through the same Channels connection — there's no bot-token-only
# fallback for card delivery.
SLACK_BOT_TOKEN=
# Channel the triage cards post to (#factory)
SLACK_CHANNEL_ID=
# App-level token (xapp-, scope connections:write) — enables Socket Mode, so
# the bot posts and hears replies with no public URL or tunnel, ever.
SLACK_APP_TOKEN=

# Railway Sandboxes (Station 2) — the ephemeral VM the audit runs in.
# Requires Priority Boarding on the Railway account; the SDK may introduce
# breaking changes between releases. Idle timeout caps at 5 minutes on
# Trial/Free plans, which is too short to be useful — Hobby or Pro needed.
# Account or team token from railway.com/account/tokens
RAILWAY_API_TOKEN=
# Environment the sandboxes are provisioned into
RAILWAY_ENVIRONMENT_ID=
